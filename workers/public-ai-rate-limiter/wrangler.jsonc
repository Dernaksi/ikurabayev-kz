{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ikurabayev-public-ai-rate-limiter",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "ratelimits": [
    {
      "name": "PUBLIC_AI_RATE_LIMITER",
      "namespace_id": "2026090201",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ]
}
