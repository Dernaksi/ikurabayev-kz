{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ikurabayev-public-ai-rate-limiter",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLIC_AI_LIMITER",
        "class_name": "PublicAiRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PublicAiRateLimiter"
      ]
    }
  ]
}
